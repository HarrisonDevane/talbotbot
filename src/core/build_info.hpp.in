namespace talbot {

// Short git commit hash (12 chars). Suffixed with "-dirty" if the working
// tree had uncommitted changes when cmake ran. "unknown" if git was not
// available or `git rev-parse HEAD` failed (e.g. building from a source tar).
//
// If you see "-dirty" in a production log, the run cannot be reproduced from
// git alone -- record the diff separately.
constexpr const char* GIT_COMMIT = "@GIT_COMMIT@";

// UTC timestamp at CMake configure time. This is when the build was set up,
// not when the linker finished -- for incremental builds these can differ by
// hours. Close enough for run provenance; use file mtime on the exe if you
// need the precise link time.
constexpr const char* BUILD_TIME = "@BUILD_TIME_UTC@";

}  // namespace talbot
