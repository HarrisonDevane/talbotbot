{
    "version": 3,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 21,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "release",
            "displayName": "Release (VS 2022 x64)",
            "description": "Optimized build for training runs and shipping. Requires env\\dev.env to be sourced first.",
            "generator": "Visual Studio 17 2022",
            "architecture": "x64",
            "binaryDir": "${sourceDir}/build",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "debug",
            "displayName": "Debug (VS 2022 x64)",
            "description": "Debug build for local diagnostics. NOT for training or benchmarks.",
            "generator": "Visual Studio 17 2022",
            "architecture": "x64",
            "binaryDir": "${sourceDir}/build-debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "release",
            "configurePreset": "release",
            "configuration": "Release",
            "jobs": 0
        },
        {
            "name": "debug",
            "configurePreset": "debug",
            "configuration": "Debug",
            "jobs": 0
        }
    ]
}
